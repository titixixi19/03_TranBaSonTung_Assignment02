@model ReportFilterVM
@{
    ViewData["Title"] = "News Report";
    var report = Model.Report;
}

<h2 class="mb-3">News Statistics Report</h2>

<form asp-action="Index" method="get" class="card card-body mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-bar-chart"></i> Generate report</button>
        </div>
    </div>
</form>

@if (report != null)
{
    <p class="text-muted">
        Period: <strong>@report.StartDate.ToString("dd/MM/yyyy")</strong> &ndash; <strong>@report.EndDate.ToString("dd/MM/yyyy")</strong>
        (by created date, sorted descending)
    </p>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card"><div class="card-body">
                <div class="text-muted small">Total articles</div>
                <div class="display-6">@report.TotalArticles</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card"><div class="card-body">
                <div class="text-muted small">Active</div>
                <div class="display-6 text-success">@report.ActiveArticles</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card"><div class="card-body">
                <div class="text-muted small">Inactive</div>
                <div class="display-6 text-secondary">@report.InactiveArticles</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var (title, items) in new[] { ("By category", report.ByCategory), ("By author", report.ByAuthor) })
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header bg-white fw-semibold">@title</div>
                    <div class="card-body">
                        @if (!items.Any())
                        {
                            <p class="text-muted mb-0">No data.</p>
                        }
                        @foreach (var item in items)
                        {
                            var percent = report.TotalArticles == 0 ? 0 : item.Count * 100 / report.TotalArticles;
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small">
                                    <span>@item.Name</span><span class="fw-semibold">@item.Count</span>
                                </div>
                                <div class="progress" style="height:8px">
                                    <div class="progress-bar" style="width:@percent%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header bg-white fw-semibold">Articles</div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Created date</th>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Author</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!report.Articles.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No news articles in this period.</td></tr>
                    }
                    @foreach (var a in report.Articles)
                    {
                        <tr>
                            <td class="text-nowrap">@a.CreatedDate?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@a.NewsArticleID</td>
                            <td>@a.NewsTitle</td>
                            <td>@a.CategoryName</td>
                            <td>@a.AuthorName</td>
                            <td>
                                <span class="badge @(a.NewsStatus == true ? "bg-success" : "bg-secondary")">@(a.NewsStatus == true ? "Active" : "Inactive")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
