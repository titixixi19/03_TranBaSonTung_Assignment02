@model string
@{
    ViewData["Title"] = "Service unavailable";
}

<div class="text-center py-5">
    <i class="bi bi-cloud-slash text-danger" style="font-size:3rem"></i>
    <h2 class="mt-3">Something went wrong</h2>
    <p class="text-muted">@Model</p>
    <a href="javascript:location.reload()" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i> Try again</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to news</a>
</div>
