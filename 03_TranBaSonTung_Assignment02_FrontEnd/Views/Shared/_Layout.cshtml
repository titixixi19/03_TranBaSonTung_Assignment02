@{
    var role = Context.Session.GetString(SessionKeys.Role);
    var userName = Context.Session.GetString(SessionKeys.AccountName);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => c == controller && (a == null || a == action) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FU News Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-newspaper me-1"></i> FU News
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">News</a></li>
                        @if (role == "Admin")
                        {
                            <li class="nav-item"><a class="nav-link @Active("Accounts")" asp-controller="Accounts" asp-action="Index">Accounts</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index">Report</a></li>
                        }
                        @if (role == "Staff")
                        {
                            <li class="nav-item"><a class="nav-link @Active("NewsArticles", "Index")" asp-controller="NewsArticles" asp-action="Index">Manage News</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Categories")" asp-controller="Categories" asp-action="Index">Categories</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Tags")" asp-controller="Tags" asp-action="Index">Tags</a></li>
                            <li class="nav-item"><a class="nav-link @Active("NewsArticles", "History")" asp-controller="NewsArticles" asp-action="History">My History</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">Profile</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (role != null)
                        {
                            <span class="navbar-text text-white small">
                                <i class="bi bi-person-circle"></i> @userName
                                <span class="badge bg-light text-primary ms-1">@role</span>
                            </span>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" asp-controller="Auth" asp-action="Register">
                                <i class="bi bi-person-plus"></i> Register
                            </a>
                            <a class="btn btn-sm btn-light" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted small">
        <div class="container py-2">&copy; @DateTime.Now.Year - FUNewsManagementSystem - PRN232 Assignment 02</div>
    </footer>

    @* Popup dialog used for all Create / Update forms *@
    <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    @* Confirmation dialog used for every Delete action *@
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger"></i> Confirm delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="confirmMessage"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmOk">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
