@model EmailFormVM
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isForgot = action == "ForgotPassword";
    ViewData["Title"] = isForgot ? "Forgot password" : "Resend confirmation email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card mt-4">
            <div class="card-body p-4">
                <h3 class="mb-1 text-center">
                    <i class="bi @(isForgot ? "bi-key" : "bi-envelope") text-primary"></i> @ViewData["Title"]
                </h3>
                <p class="text-muted text-center mb-4">
                    @(isForgot ? "Enter your email and we will send you a link to reset your password."
                               : "Enter your email and we will send a new confirmation link.")
                </p>
                <form asp-action="@action" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Send email</button>
                </form>
                <hr />
                <p class="text-center mb-0 small"><a asp-action="Login">Back to login</a></p>
            </div>
        </div>
    </div>
</div>
