@model AccountFormVM

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post" class="ajax-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <input type="hidden" asp-for="AccountID" />

    <div class="mb-3">
        <label asp-for="AccountName" class="form-label"></label>
        <input asp-for="AccountName" class="form-control" />
        <span asp-validation-for="AccountName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AccountEmail" class="form-label"></label>
        <input asp-for="AccountEmail" class="form-control" />
        <span asp-validation-for="AccountEmail" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AccountRole" class="form-label"></label>
        <select asp-for="AccountRole" class="form-select">
            <option value="1">Staff</option>
            <option value="2">Lecturer</option>
        </select>
        <span asp-validation-for="AccountRole" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AccountPassword" class="form-label"></label>
        <input asp-for="AccountPassword" class="form-control" placeholder="@(Model.IsEdit ? "Leave blank to keep current password" : "")" />
        <span asp-validation-for="AccountPassword" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create")</button>
    </div>
</form>
