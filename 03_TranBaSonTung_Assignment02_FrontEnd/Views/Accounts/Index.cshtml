@model List<AccountVM>
@{
    ViewData["Title"] = "Account Management";
    int? role = ViewBag.Role;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Account Management</h2>
    <button class="btn btn-primary" data-modal-url="@Url.Action("Create")" data-modal-title="Create account">
        <i class="bi bi-plus-lg"></i> New account
    </button>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-6">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Search by name or email" />
        </div>
        <div class="col-md-3">
            <select name="role" class="form-select">
                <option value="">All roles</option>
                <option value="1" selected="@(role == 1)">Staff</option>
                <option value="2" selected="@(role == 2)">Lecturer</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No accounts found.</td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.AccountID</td>
                        <td>@a.AccountName</td>
                        <td>@a.AccountEmail</td>
                        <td><span class="badge @(a.AccountRole == 1 ? "bg-info" : "bg-secondary")">@a.RoleName</span></td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("Edit", new { id = a.AccountID })" data-modal-title="Edit account">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <form asp-action="Delete" asp-route-id="@a.AccountID" method="post" class="d-inline confirm-form"
                                  data-confirm="Delete account '@a.AccountName'? This cannot be undone.">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
