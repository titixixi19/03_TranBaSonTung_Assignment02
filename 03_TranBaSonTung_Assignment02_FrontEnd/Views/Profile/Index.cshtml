@model AccountVM
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h2 class="mb-0">My Profile</h2>
                        <p class="text-muted mb-0">Manage your account information</p>
                    </div>
                    <button class="btn btn-primary" data-modal-url="@Url.Action("Edit")" data-modal-title="Edit profile">
                        <i class="bi bi-pencil"></i> Edit profile
                    </button>
                </div>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Account ID</dt>
                    <dd class="col-sm-8">@Model.AccountID</dd>
                    <dt class="col-sm-4">Full name</dt>
                    <dd class="col-sm-8">@Model.AccountName</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.AccountEmail</dd>
                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8"><span class="badge bg-info">@Model.RoleName</span></dd>
                </dl>
                <hr />
                <a asp-controller="NewsArticles" asp-action="History" class="btn btn-outline-primary">
                    <i class="bi bi-clock-history"></i> View my news history
                </a>
            </div>
        </div>
    </div>
</div>
