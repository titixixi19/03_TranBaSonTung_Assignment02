@model NewsArticleVM
@{
    ViewData["Title"] = Model.NewsTitle;
}

<a asp-action="Index" class="btn btn-link px-0 mb-2"><i class="bi bi-arrow-left"></i> Back to news</a>

<article class="card">
    <div class="card-body p-4">
        <div class="mb-2">
            <span class="badge bg-primary">@Model.Category?.CategoryName</span>
            @if (Model.NewsStatus != true)
            {
                <span class="badge bg-secondary">Inactive</span>
            }
        </div>
        <h1 class="h3">@Model.NewsTitle</h1>
        <p class="lead text-muted">@Model.Headline</p>
        <div class="small text-muted mb-3">
            <i class="bi bi-person"></i> @Model.CreatedBy?.AccountName
            &middot; <i class="bi bi-calendar"></i> @Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm")
            @if (Model.ModifiedDate.HasValue && Model.ModifiedDate != Model.CreatedDate)
            {
                <span>&middot; Updated @Model.ModifiedDate?.ToString("dd/MM/yyyy HH:mm")</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.NewsSource))
            {
                <span>&middot; Source: @Model.NewsSource</span>
            }
        </div>
        <hr />
        <div class="news-content">@Model.NewsContent</div>
        <hr />
        <div>
            @foreach (var t in Model.Tags)
            {
                <span class="badge rounded-pill bg-light text-dark border">#@t.TagName?.Trim()</span>
            }
        </div>
    </div>
</article>
