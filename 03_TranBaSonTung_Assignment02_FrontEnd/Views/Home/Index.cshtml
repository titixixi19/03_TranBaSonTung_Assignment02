@model NewsSearchVM
@{
    ViewData["Title"] = "News";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h2 class="mb-0">FU News</h2>
        <p class="text-muted mb-0">Latest news from FPT University</p>
    </div>
    <form method="get" class="d-flex flex-wrap gap-2">
        <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Search news..." style="min-width:220px" />
        <select name="categoryId" class="form-select" style="min-width:180px">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.CategoryID" selected="@(Model.CategoryId == c.CategoryID)">@c.CategoryName</option>
            }
        </select>
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </form>
</div>

@if (!Model.Articles.Any())
{
    <div class="alert alert-info">No news articles found.</div>
}

<div class="row g-3">
    @foreach (var n in Model.Articles)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card news-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="mb-2">
                        <span class="badge bg-light text-primary border">@n.Category?.CategoryName</span>
                    </div>
                    <h5 class="card-title">
                        <a asp-action="Details" asp-route-id="@n.NewsArticleID">@n.NewsTitle</a>
                    </h5>
                    <p class="card-text text-muted small flex-grow-1">
                        @(n.NewsContent?.Length > 160 ? n.NewsContent.Substring(0, 160) + "..." : n.NewsContent)
                    </p>
                    <div class="mb-2">
                        @foreach (var t in n.Tags)
                        {
                            <span class="badge rounded-pill bg-light text-dark border">#@t.TagName?.Trim()</span>
                        }
                    </div>
                    <div class="small text-muted d-flex justify-content-between">
                        <span><i class="bi bi-person"></i> @n.CreatedBy?.AccountName</span>
                        <span><i class="bi bi-calendar"></i> @n.CreatedDate?.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
