@model List<TagVM>
@{
    ViewData["Title"] = "Tag Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Tag Management</h2>
    <button class="btn btn-primary" data-modal-url="@Url.Action("Create")" data-modal-title="Create tag">
        <i class="bi bi-plus-lg"></i> New tag
    </button>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-9">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Search by tag name or note" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Tag name</th>
                    <th>Note</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No tags found.</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.TagID</td>
                        <td class="fw-semibold">@t.TagName</td>
                        <td class="small text-muted">@t.Note</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("Edit", new { id = t.TagID })" data-modal-title="Edit tag">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <form asp-action="Delete" asp-route-id="@t.TagID" method="post" class="d-inline confirm-form"
                                  data-confirm="Delete tag '@t.TagName'? This cannot be undone.">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
